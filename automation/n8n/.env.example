# Copia este fichero a automation/n8n/.env y rellena los valores. NUNCA subas .env al repositorio.
# Sólo para n8n en local: no uses aquí URLs ni claves de producción.

# Clave con la que n8n cifra las credenciales de su volumen. Genérala una vez y no la cambies
# (si la pierdes, hay que volver a crear las credenciales):  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# API a la que llaman los workflows. Por defecto, la API local (uvicorn en el anfitrión, puerto 8000).
API_BASE_URL=http://host.docker.internal:8000

# Puerto local del editor de n8n (http://localhost:5678).
N8N_PORT=5678
GENERIC_TIMEZONE=Europe/Madrid

# La clave interna (X-Internal-API-Key) NO va aquí: se guarda como credencial de n8n
# (ver README.md, "Crear la credencial").
