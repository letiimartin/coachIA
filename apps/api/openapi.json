{
  "components": {
    "schemas": {
      "AuthorizeUrlOut": {
        "properties": {
          "authorize_url": {
            "title": "Authorize Url",
            "type": "string"
          }
        },
        "required": [
          "authorize_url"
        ],
        "title": "AuthorizeUrlOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IntegrationOut": {
        "description": "Estado de una integración. Nunca incluye tokens.",
        "properties": {
          "connected_at": {
            "format": "date-time",
            "title": "Connected At",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_sync_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sync At"
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/IntegrationStatus"
          },
          "token_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Expires At"
          }
        },
        "required": [
          "provider",
          "status",
          "scopes",
          "connected_at",
          "token_expires_at",
          "last_sync_at",
          "last_error"
        ],
        "title": "IntegrationOut",
        "type": "object"
      },
      "IntegrationStatus": {
        "enum": [
          "active",
          "revoked",
          "error"
        ],
        "title": "IntegrationStatus",
        "type": "string"
      },
      "InternalSyncOut": {
        "description": "Resultado agregado de sincronizar todas las integraciones activas.",
        "properties": {
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "integrations": {
            "title": "Integrations",
            "type": "integer"
          },
          "rate_limited": {
            "title": "Rate Limited",
            "type": "boolean"
          },
          "succeeded": {
            "title": "Succeeded",
            "type": "integer"
          },
          "unchanged": {
            "title": "Unchanged",
            "type": "integer"
          },
          "updated": {
            "title": "Updated",
            "type": "integer"
          }
        },
        "required": [
          "integrations",
          "succeeded",
          "failed",
          "rate_limited",
          "created",
          "updated",
          "unchanged"
        ],
        "title": "InternalSyncOut",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "PingResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "PingResponse",
        "type": "object"
      },
      "Provider": {
        "enum": [
          "wahoo",
          "strava",
          "suunto",
          "garmin"
        ],
        "title": "Provider",
        "type": "string"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "error",
                "not_configured"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReceivedResponse": {
        "properties": {
          "received": {
            "title": "Received",
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ],
        "title": "ReceivedResponse",
        "type": "object"
      },
      "RootResponse": {
        "properties": {
          "health": {
            "title": "Health",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "health"
        ],
        "title": "RootResponse",
        "type": "object"
      },
      "StravaEvent": {
        "properties": {
          "aspect_type": {
            "enum": [
              "create",
              "update",
              "delete"
            ],
            "title": "Aspect Type",
            "type": "string"
          },
          "event_time": {
            "title": "Event Time",
            "type": "integer"
          },
          "object_id": {
            "title": "Object Id",
            "type": "integer"
          },
          "object_type": {
            "enum": [
              "activity",
              "athlete"
            ],
            "title": "Object Type",
            "type": "string"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "integer"
          },
          "subscription_id": {
            "title": "Subscription Id",
            "type": "integer"
          },
          "updates": {
            "additionalProperties": true,
            "title": "Updates",
            "type": "object"
          }
        },
        "required": [
          "object_type",
          "object_id",
          "aspect_type",
          "owner_id",
          "subscription_id",
          "event_time"
        ],
        "title": "StravaEvent",
        "type": "object"
      },
      "SyncOut": {
        "description": "Resultado de una sincronización: actividades creadas, actualizadas y sin cambios.",
        "properties": {
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "unchanged": {
            "title": "Unchanged",
            "type": "integer"
          },
          "updated": {
            "title": "Updated",
            "type": "integer"
          }
        },
        "required": [
          "created",
          "updated",
          "unchanged"
        ],
        "title": "SyncOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "JWT de Supabase Auth",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "CoachIA API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/wahoo/callback": {
      "get": {
        "operationId": "wahoo_callback_auth_wahoo_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "",
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Wahoo Callback",
        "tags": [
          "wahoo"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/internal/ping": {
      "get": {
        "description": "Permite a n8n comprobar que la API responde y que su clave es correcta.",
        "operationId": "ping_internal_ping_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-internal-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ping",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/sync/wahoo": {
      "post": {
        "description": "Sincroniza las actividades de todas las integraciones de Wahoo activas (para n8n).\n\nSi Wahoo aplica el límite de peticiones se detiene (`rate_limited`): el resto de usuarios se\nsincroniza en la siguiente ejecución, empezando por los que llevan más tiempo sin hacerlo.",
        "operationId": "sync_wahoo_all_internal_sync_wahoo_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-internal-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalSyncOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sync Wahoo All",
        "tags": [
          "internal"
        ]
      }
    },
    "/v1/integrations": {
      "get": {
        "operationId": "list_integrations_v1_integrations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IntegrationOut"
                  },
                  "title": "Response List Integrations V1 Integrations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Integrations",
        "tags": [
          "integrations"
        ]
      }
    },
    "/v1/integrations/wahoo": {
      "delete": {
        "operationId": "disconnect_wahoo_v1_integrations_wahoo_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Disconnect Wahoo",
        "tags": [
          "integrations"
        ]
      }
    },
    "/v1/integrations/wahoo/authorize-url": {
      "get": {
        "description": "URL a la que la app debe enviar al usuario para autorizar CoachIA en Wahoo.",
        "operationId": "wahoo_authorize_url_v1_integrations_wahoo_authorize_url_get",
        "parameters": [
          {
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "default": "mobile",
              "enum": [
                "mobile",
                "web"
              ],
              "title": "Platform",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeUrlOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Wahoo Authorize Url",
        "tags": [
          "integrations"
        ]
      }
    },
    "/v1/integrations/wahoo/sync": {
      "post": {
        "description": "Importa las actividades realizadas en Wahoo. Es idempotente: se puede repetir sin riesgo.",
        "operationId": "sync_wahoo_v1_integrations_wahoo_sync_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Sync Wahoo",
        "tags": [
          "integrations"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "read_me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Me",
        "tags": [
          "me"
        ]
      }
    },
    "/webhooks/strava": {
      "get": {
        "operationId": "verify_subscription_webhooks_strava_get",
        "parameters": [
          {
            "in": "query",
            "name": "hub.mode",
            "required": true,
            "schema": {
              "title": "Hub.Mode",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hub.verify_token",
            "required": true,
            "schema": {
              "title": "Hub.Verify Token",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hub.challenge",
            "required": true,
            "schema": {
              "title": "Hub.Challenge",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Verify Subscription Webhooks Strava Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Subscription",
        "tags": [
          "webhooks"
        ]
      },
      "post": {
        "operationId": "receive_event_webhooks_strava_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StravaEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceivedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receive Event",
        "tags": [
          "webhooks"
        ]
      }
    }
  }
}
