# Copia este fichero a apps/mobile/.env y rellena los valores (todos son públicos: van en el bundle).
EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<clave anon/publishable>
# URL base de la API de CoachIA (sin barra final). Sin ella, la app usa los datos de prueba del contrato.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Datos de prueba (examples del contrato): auto (sólo si la API responde 501) | on (siempre) | off (nunca).
EXPO_PUBLIC_API_MOCK=auto
