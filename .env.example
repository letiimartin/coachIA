# Copia este fichero a .env y rellena los valores. NUNCA subas .env al repositorio.

# --- apps/api (backend FastAPI) ---
ENVIRONMENT=local            # local | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8081   # lista separada por comas
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Sólo para proyectos con el JWT secret heredado (HS256). Los nuevos usan JWKS y no lo necesitan.
SUPABASE_JWT_SECRET=
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_REDIRECT_URI=https://letismartcoach.onrender.com/auth/wahoo/callback
TOKEN_ENCRYPTION_KEY=        # clave Fernet: cd apps/api && uv run python -m app.core.crypto
OAUTH_STATE_SECRET=          # cadena aleatoria larga
APP_RETURN_URL_MOBILE=letismartcoach://integrations
APP_RETURN_URL_WEB=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_EUR=4
INTERNAL_API_KEY=
STRAVA_VERIFY_TOKEN=

# --- apps/mobile: estas variables van en apps/mobile/.env (Expo lee el .env de su carpeta).
#     Las EXPO_PUBLIC_* acaban dentro de la app: NUNCA pongas secretos aquí. ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WAHOO_CLIENT_ID=
EXPO_PUBLIC_WAHOO_REDIRECT_URI=
EXPO_PUBLIC_WEB_URL=
